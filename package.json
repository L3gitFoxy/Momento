{
  "name": "momento",
  "version": "9.1.0",
  "description": "Momento \u2014 offline-first gamified schedule app with optional google sync",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "release": "node scripts/prepare-release-notes.js && electron-builder --win --publish never",
    "release:all": "electron-builder -mwl --publish always",
    "prepare-release-notes": "node scripts/prepare-release-notes.js",
    "release:publish": "node scripts/prepare-release-notes.js && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.momento.app",
    "productName": "Momento",
    "icon": "assets/icon.ico",
    "compression": "maximum",
    "files": [
      "electron-main.js",
      "preload.js",
      "index.html",
      "script.js",
      "style.css",
      "ai-chatbot.js",
      "chatbot-nlp.json",
      "ai-generations-nlp.json",
      "assets/**/*",
      "music-server/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!dist/**",
      "!.git/**",
      "!.github/**",
      "!supabase/**",
      "!**/*.md",
      "!AUTO_UPDATE.md"
    ],
    "asar": true,
    "asarUnpack": [
      "music-server/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "L3gitFoxy",
        "repo": "Momento",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Momento-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes-current.md"
    }
  },
  "author": "Momento",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/l3gitfoxy/momento.git"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
