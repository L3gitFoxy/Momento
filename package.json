{
  "name": "momento",
  "version": "9.2.0",
  "description": "Momento \u2014 offline-first gamified schedule app with optional google sync",
  "main": "electron/electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "node -e \"console.log('Vercel/web build: static files, skip electron-builder')\"",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "release": "node scripts/prepare-release-notes.js && electron-builder --win --publish never",
    "release:publish": "node scripts/prepare-release-notes.js && electron-builder --win --publish always",
    "prepare-release-notes": "node scripts/prepare-release-notes.js"
  },
  "build": {
    "appId": "com.momento.app",
    "productName": "Momento",
    "copyright": "Copyright \u00a9 Momento",
    "icon": "assets/icon.ico",
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/**/*",
      "server/**/*",
      "assets/**/*",
      "index.html",
      "style.css",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!dist/**",
      "!.git/**",
      "!.github/**",
      "!supabase/**",
      "!**/*.md",
      "!docs/**",
      "!scripts/**",
      "!release-notes-current.md",
      "!ad_*/**",
      "!*.mp4",
      "!Momento*.zip"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "L3gitFoxy",
        "repo": "Momento",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Momento-Setup-${version}.${ext}",
      "executableName": "Momento"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "guid": "a8f3c2e1-9b4d-4e6a-8c1f-2d7e5b0a9f3c",
      "uninstallDisplayName": "Momento",
      "shortcutName": "Momento",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "runAfterFinish": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes-current.md"
    }
  },
  "author": "Momento",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/L3gitFoxy/Momento.git"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
